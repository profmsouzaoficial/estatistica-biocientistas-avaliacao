# ---------------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e configure os mesmos nomes na Vercel.
# Só variáveis VITE_* chegam ao navegador — e apenas as duas primeiras devem ir.
# ---------------------------------------------------------------------------

# --- Supabase (obrigatório para sair do modo demonstração) -------------------
# Project Settings → API
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_ANON_KEY=cole_a_chave_anon_publica

# Só no servidor (funções de API). NUNCA prefixe com VITE_.
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_ANON_KEY=cole_a_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key

# Token pessoal para aplicar as migrations (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_...

# Na Vercel, VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY recebem os mesmos valores de
# SUPABASE_URL e SUPABASE_ANON_KEY (não existe variável VITE_ no arquivo de segredos).

# --- Corretor (Llama no Coolify) --------------------------------------------
# Endpoint compatível com OpenAI terminando em /v1 (llama.cpp: /v1, Ollama: /v1).
# Precisa ser acessível pela internet: as funções rodam na Vercel, não na sua rede.
LLM_BASE_URL=https://seu-servico-coolify.exemplo.com/v1
LLM_MODEL=llama-3.3-70b-instruct
LLM_API_KEY=
# 1 = pede response_format json_object (llama.cpp/vLLM/OpenRouter aceitam)
LLM_JSON_MODE=0
# corta a redação em N palavras para o modelo não estourar o contexto
LLM_MAX_PALAVRAS=1200
# teto de tokens da resposta (subir para modelos verborrágicos; 1400 cobre 4 critérios)
LLM_MAX_TOKENS=1400

# --- Visão / transcrição da foto -------------------------------------------
# openrouter | google | google-cloud
#   google-cloud = Cloud Vision (DOCUMENT_TEXT_DETECTION), o melhor em letra
#   manuscrita; VISION_API_KEY aceita a chave de API simples ou o JSON inteiro
#   da conta de serviço (nesse caso o app troca por token OAuth RS256).
VISION_PROVIDER=google-cloud
VISION_API_KEY=
# OpenRouter: https://openrouter.ai/api/v1 · Google usa a rota nativa do Gemini
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.5-flash

# --- SIGA -------------------------------------------------------------------
SIGA_API_BASE=https://siga-api.sparklingtech.com.br
SIGA_API_KEY=
SIGA_TURMA=CBV018GV-A
SIGA_PERIODO=2026/3

# --- Deploy -----------------------------------------------------------------
VERCEL_TOKEN=

# Escala da nota que o app grava no SIGA.
#   pontos          → 0 até o peso da avaliação (é a escala do SIGA em GV)
#   nota10 (padrão) → 0 a 10
# Como saber: procure no SIGA uma avaliação de peso 20 e veja as notas. Em 2026/3,
# "Prova 1" (peso 20) tem notas 19, 17, 16 — logo a escala é "pontos". Quando o peso
# difere do valor total da rubrica, a nota é convertida proporcionalmente.
SIGA_ESCALA=pontos

# Prazo de cada correção. O padrão (55000 ms) cabe no limite de 60 s da Vercel
# Hobby; para um modelo grande em CPU, rode `pnpm corrigir:lote` no seu servidor,
# onde o script já espera 10 minutos.
# LLM_TIMEOUT_MS=55000

# ---------------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e configure os mesmos nomes na Vercel.
# Só variáveis VITE_* chegam ao navegador — e apenas as duas primeiras devem ir.
# ---------------------------------------------------------------------------

# --- Supabase (obrigatório para sair do modo demonstração) -------------------
# Project Settings → API
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_ANON_KEY=cole_a_chave_anon_publica

# Só no servidor (funções de API). NUNCA prefixe com VITE_.
SUPABASE_URL=https://SEU-REF.supabase.co
SUPABASE_ANON_KEY=cole_a_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key

# Token pessoal para aplicar as migrations (https://supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=sbp_...

# Na Vercel, VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY recebem os mesmos valores de
# SUPABASE_URL e SUPABASE_ANON_KEY (não existe variável VITE_ no arquivo de segredos).

# --- Corretor (API da DeepSeek) ---------------------------------------------
# Caminho recomendado: um provedor só, para ler a foto e para corrigir.
# Atalho: pnpm configurar:ia --deepseek --chave sk-... --foto foto.jpg
# Endpoint compatível com OpenAI; na DeepSeek é https://api.deepseek.com.
# Também funciona com llama.cpp/Ollama no Coolify ou qualquer /v1 compatível.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
# 1 = pede response_format json_object (llama.cpp/vLLM/OpenRouter aceitam)
LLM_JSON_MODE=1
# 1 = desliga o "pensamento" (a DeepSeek liga por padrão). A correção quer JSON
# fechado e a mesma nota para o mesmo texto, dentro do prazo de 55 s.
LLM_SEM_PENSAMENTO=1
# corta a redação em N palavras para o modelo não estourar o contexto
LLM_MAX_PALAVRAS=1200
# teto de tokens da resposta (subir para modelos verborrágicos; 1400 cobre 4 critérios)
LLM_MAX_TOKENS=1400

# --- Visão / transcrição da foto -------------------------------------------
# deepseek | openai | openrouter | google | google-cloud
#   deepseek    = POST /v1/tools/ocr (multipart). Devolve o texto da página sem
#                 passar por modelo de chat, então não "arruma" a escrita do aluno.
#                 Usa LLM_API_KEY quando VISION_API_KEY está vazia.
#   google-cloud = Cloud Vision (DOCUMENT_TEXT_DETECTION); VISION_API_KEY aceita
#                 chave de API simples ou o JSON da conta de serviço.
#   openai       = modelo que enxerga imagem (Qwen2.5-VL, MiniCPM-V, Llama 3.2
#                 Vision) no mesmo /v1 do corretor.
VISION_PROVIDER=deepseek
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash

# --- SIGA -------------------------------------------------------------------
SIGA_API_BASE=https://siga-api.sparklingtech.com.br
SIGA_API_KEY=
SIGA_TURMA=CBV018GV-A
SIGA_PERIODO=2026/3

# --- Deploy -----------------------------------------------------------------
VERCEL_TOKEN=

# Escala da nota que o app grava no SIGA.
#   pontos          → 0 até o peso da avaliação (é a escala do SIGA em GV)
#   nota10 (padrão) → 0 a 10
# Como saber: procure no SIGA uma avaliação de peso 20 e veja as notas. Em 2026/3,
# "Prova 1" (peso 20) tem notas 19, 17, 16 — logo a escala é "pontos". Quando o peso
# difere do valor total da rubrica, a nota é convertida proporcionalmente.
SIGA_ESCALA=pontos

# Prazo de cada correção. O padrão (55000 ms) cabe no limite de 60 s da Vercel
# Hobby; para um modelo grande em CPU, rode `pnpm corrigir:lote` no seu servidor,
# onde o script já espera 10 minutos.
# LLM_TIMEOUT_MS=55000

# Prazo das demais chamadas externas, em milissegundos. Sem prazo, um serviço que
# não responde é morto pela Vercel e o navegador recebe um 504 vazio ("erro de
# rede"), em vez de um código dizendo qual serviço falhou.
#   banco, login e Storage do Supabase → padrão 8000 (HTTP_TIMEOUT_MS)
#   API do SIGA                       → padrão 15000 (SIGA_TIMEOUT_MS)
#   leitura da foto (OCR)             → padrão 25000 (OCR_TIMEOUT_MS)
#   download da foto no Storage       → padrão 15000 (STORAGE_TIMEOUT_MS)
# HTTP_TIMEOUT_MS=8000
# SIGA_TIMEOUT_MS=15000
# OCR_TIMEOUT_MS=25000
# STORAGE_TIMEOUT_MS=15000
